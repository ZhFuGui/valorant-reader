// 正式文件属性，与生产安装名对应。许可证仍单独随安装包分发。
#pragma code_page(65001)
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if defined(_DEBUG)
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Northwind Systems"
            VALUE "FileDescription", "Runtime Node"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "RuntimeNode"
            VALUE "OriginalFilename", "RuntimeNode.exe"
            VALUE "ProductName", "Runtime Node"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Comments", "Third-party notices are provided in LICENSE.txt."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
