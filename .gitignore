# 默认忽略，仅允许产品源码、工程配置和正式协议入库。
*
!/.gitignore
!/.gitattributes
!/.clang-format
!/README.md
!/LICENSE.txt
!/valorant-reader.sln

!/projects/
!/projects/reader/
!/projects/reader/valorant-reader.vcxproj
!/projects/reader/valorant-reader.vcxproj.filters

!/build/
!/build/compiler.props
!/build/artifacts.props

!/resources/
!/resources/version.rc

!/src/
!/src/**/
!/src/**/*.hpp
!/src/**/*.cpp

!/protocol/
!/protocol/**/
!/protocol/**/*.proto
!/protocol/**/contract.json
!/protocol/**/schema-manifest.json
!/protocol/**/*.descriptor.pb

# 本地工具、日志、dump、测试和 agent 文件不属于产品源码。
**/.codex*/
**/.claude*/
**/test/
**/tests/
/src/**/test_*
/src/**/test-*
/src/**/*_test.*
/src/**/*_tests.*
/src/**/*_checks.*
